# VINAYVERSE AI backend — environment configuration
# Copy to .env and fill in. NEVER commit a real .env with secrets.

# --- AI provider (REQUIRED for real AI; server-only, never in the app) ---
# Your OpenAI-compatible API key. The server reads it only from env vars.
AI_API_KEY=
# Base URL of the chat-completions API (default: https://api.openai.com/v1).
# Any OpenAI-compatible endpoint works (e.g. a self-hosted gateway).
AI_BASE_URL=https://api.openai.com/v1
# Chat model for the AI Coach (default: gpt-4o-mini).
AI_MODEL=gpt-4o-mini
# Vision-capable model for food photo analysis (default: gpt-4o-mini).
# IMPORTANT: this model MUST support image input, or /analyze-food will fail.
AI_VISION_MODEL=gpt-4o-mini

# --- Test double (NEVER enable in production) ---
# AI_MOCK=1 returns canned, obviously-fake responses tagged "mock": true.
# For automated tests and local smoke-testing only.
#AI_MOCK=1

# --- Server ---
# Port the server listens on.
PORT=3001

# --- CORS ---
# Comma-separated list of allowed app origins, e.g.:
# CORS_ORIGIN=https://your-app-domain.com,https://www.your-app-domain.com
# If the VINAYVERSE single-file HTML is opened directly from file://,
# browsers send `Origin: null` — add the literal "null" to allow it, e.g.:
# CORS_ORIGIN=null
# If unset, ALL origins are allowed (loud warning at startup; dev only).
#CORS_ORIGIN=

# --- Limits & safety ---
# Max uploaded photo size in MB (the app caps at 12; keep in sync).
MAX_UPLOAD_MB=12
# Per-IP rate limit: max requests per minute on API routes (default 30).
RATE_LIMIT_PER_MIN=30
# Upstream AI timeout in ms (advanced; default 50000). Server timeout is 60s.
#AI_TIMEOUT_MS=50000
